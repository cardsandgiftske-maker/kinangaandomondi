rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rsvps/{document} {
      // RSVP creation and all RSVP administration run through trusted Vercel API routes.
      allow read, write: if false;
    }
    match /gallery/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id', 'url', 'caption', 'uploaderName', 'deviceInfo', 'likes', 'uploadedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://res.cloudinary.com/.*')
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 300
        && request.resource.data.uploaderName is string
        && request.resource.data.uploaderName.size() <= 80
        && request.resource.data.likes == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;
      allow delete: if false;
    }
  }
}
